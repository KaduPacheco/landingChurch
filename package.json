{
  "name": "simplechurch-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-isolation=none tests/leads.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "helmet": "7.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
