# Local development only. Real values must be configured in Vercel Project Settings.
PORT=3000

# Required for /api/leads.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres


# Optional. Comma-separated list for external callers or custom domains.
# Same-origin Vercel requests work without this, but production domains should be explicit.
ALLOWED_ORIGINS=https://simplechurch.com.br,https://www.simplechurch.com.br

# Optional. Defaults to the production n8n webhook.
N8N_WEBHOOK_URL=https://n8n.forteia.com.br/webhook/LandingChurch

# Optional analytics. Configure real IDs in Vercel Project Settings.
# When GTM_ID is set, direct forwarding defaults to false to prevent duplicate events.
GTM_ID=
GA4_ID=
META_PIXEL_ID=
ANALYTICS_DIRECT_FORWARDING=
